# ---------------------------------------------------------------------------
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these as Cloudflare Worker variables/secrets:
#   npx wrangler secret put RAZORPAY_KEY_SECRET   (etc.)
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle — only
# put values there that are safe to be public.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows a "Sample" tag on placeholder content/images. Set to false in production.
NEXT_PUBLIC_SHOW_SAMPLE_BADGES=true
# Image delivery (build time): "direct" = straight from Cloudinary/Unsplash (local dev);
# "cloudflare" = same-origin via Cloudflare Image Transformations (production; see README).
NEXT_PUBLIC_IMAGE_DELIVERY=direct

# --- Database ---------------------------------------------------------------
# Local development (npm run db:local:init starts a private PostgreSQL on port 54329):
DATABASE_URL=postgresql://postgres@localhost:54329/resort
DIRECT_URL=postgresql://postgres@localhost:54329/resort
# Integration tests use a SEPARATE database (must contain "test" in its name):
TEST_DATABASE_URL=postgresql://postgres@localhost:54329/resort_test
#
# Supabase (staging/production) — replace the two lines above with:
#   DATABASE_URL = transaction pooler, port 6543 (used by the app outside Cloudflare)
#   DIRECT_URL   = session pooler / direct, port 5432 (used by `prisma migrate deploy`)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# On Cloudflare the app connects through the HYPERDRIVE binding instead (wrangler.jsonc).

# --- Supabase Auth (admin login) — Phase 4 ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-or-publishable-key
# Server-only. Used solely for admin user management scripts; never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay — Phase 5 -----------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Any long random string; enter the same value when creating the webhook in the Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Protects /api/cron/release-holds (called by the Cloudflare Cron Trigger). Any long random string.
CRON_SECRET=

# --- Cloudinary (image uploads) — Phase 4 -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (email) — Phase 6 -----------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Resort Bookings <bookings@example.com>"
ADMIN_NOTIFICATION_EMAIL=owner@example.com

# --- Error monitoring (optional) -------------------------------------------
SENTRY_DSN=
