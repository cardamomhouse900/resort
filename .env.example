# ---------------------------------------------------------------------------
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these as Cloudflare Worker variables/secrets:
#   npx wrangler secret put RAZORPAY_KEY_SECRET   (etc.)
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle — only
# put values there that are safe to be public.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows a "Sample" tag on placeholder content/images. Set to false in production.
NEXT_PUBLIC_SHOW_SAMPLE_BADGES=true

# --- Database (Supabase Postgres) — Phase 3 ----------------------------------
# Pooled connection (Supavisor, transaction mode, port 6543) used by the app.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) used only by Prisma migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Supabase Auth (admin login) — Phase 4 ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-or-publishable-key
# Server-only. Used solely for admin user management scripts; never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay — Phase 5 -----------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (image uploads) — Phase 4 -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (email) — Phase 6 -----------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Resort Bookings <bookings@example.com>"
ADMIN_NOTIFICATION_EMAIL=owner@example.com

# --- Error monitoring (optional) -------------------------------------------
SENTRY_DSN=
