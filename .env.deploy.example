# Production build values for `npm run deploy` (scripts/deploy.mjs).
# Copy to .env.deploy (git-ignored) and fill in. NOTHING secret goes here except DATABASE_URL,
# which is only used during the build and is verified NOT to be bundled.
# Server secrets (Razorpay secret, CRON_SECRET, Resend key…) are Worker secrets instead:
#   npx wrangler secret put NAME

# Public URL of the deployment — first https://mountain-resort.<your-subdomain>.workers.dev,
# later the real domain. Used for canonical links, sitemap, emails.
NEXT_PUBLIC_SITE_URL=https://mountain-resort.YOUR-SUBDOMAIN.workers.dev
# Keep "true" while placeholder content is still on the site.
NEXT_PUBLIC_SHOW_SAMPLE_BADGES=true
NEXT_PUBLIC_IMAGE_DELIVERY=direct

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-or-publishable-key
# Test key until the go-live checklist is complete; must match the RAZORPAY_KEY_ID secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Build only: production database (Supabase → Connect → Session pooler, port 5432), used to
# prerender pages with production content. The live Worker connects through Hyperdrive instead.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
