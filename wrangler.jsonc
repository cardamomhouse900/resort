{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mountain-resort",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },

  "services": [
    // Self-reference, required by OpenNext for revalidation. Must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "mountain-resort" },
  ],

  // Incremental cache — create once: npx wrangler r2 bucket create mountain-resort-cache
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "mountain-resort-cache" }],

  // Tag cache — create once: npx wrangler d1 create mountain-resort-tag-cache
  // then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "mountain-resort-tag-cache",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],

  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],

  // Phase 3 adds a Hyperdrive binding (pooled Postgres connection to Supabase).
  // Phase 5 adds a cron trigger to release expired payment holds.
}
