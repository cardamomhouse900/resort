{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mountain-resort",
  // Custom entry = OpenNext worker + cron handler (see worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // First deployment runs on https://mountain-resort.<your-subdomain>.workers.dev (see docs/DEPLOYMENT.md).
  "workers_dev": true,

  "services": [
    // Self-reference, required by OpenNext for revalidation. Must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "mountain-resort" },
  ],

  // Incremental cache — create once: npx wrangler r2 bucket create mountain-resort-cache
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "mountain-resort-cache" }],

  // Tag cache — create once: npx wrangler d1 create mountain-resort-tag-cache
  // then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "mountain-resort-tag-cache",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],

  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],

  // Pooled PostgreSQL connection to Supabase. Create once with Supabase's DIRECT connection
  // string (Hyperdrive does its own pooling — Cloudflare recommends direct over Supabase's poolers):
  //   npx wrangler hyperdrive create mountain-resort-db --connection-string="<Supabase direct connection URL>"
  // then paste the returned id below. `localConnectionString` is used by `npm run preview`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@localhost:54329/resort",
    },
  ],

  // Rate limits for sensitive endpoints (per client IP). Keep in sync with src/lib/rate-limit.ts.
  "ratelimits": [
    { "name": "RL_AVAILABILITY", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_BOOKING", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_CONTACT", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_LOGIN", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
  ],

  // Releases expired payment holds every 5 minutes (worker.ts → /api/cron/release-holds).
  "triggers": { "crons": ["*/5 * * * *"] },
}
