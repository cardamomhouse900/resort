# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
/.next/
/out/
/build
/dist

# Cloudflare Workers / OpenNext
/.open-next/
/.wrangler/

# Vercel (not used, but harmless if someone runs it)
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Secrets — NEVER commit real credentials
# (Razorpay, Supabase, Cloudinary, Resend, database URLs)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.deploy.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
.sentryclirc

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Generated Prisma client (regenerated by `prisma generate`)
/src/generated/
# Local database dumps / backups — may contain guest personal data
*.sql.gz
*.dump
/backups/
# Supabase CLI local state
/supabase/.branches/
/supabase/.temp/

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.lighthouseci/

# ---------------------------------------------------------------------------
# Logs & debug
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# OS & editor files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local temporary files
/tmp/
*.tmp

# Local development database (scripts/local-db.mjs)
/.local/
