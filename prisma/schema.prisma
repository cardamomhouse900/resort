// Mountain Nature Resort — database schema (PostgreSQL / Supabase)
//
// Booking inventory model
// -----------------------
// RoomType (what guests book: "Valley View Cottage")
//   └─ Room (physical units: "Valley View 1", "Valley View 2", …)
//        └─ Reservation (one row per unit per stay — a guest booking OR an admin block)
//
// A guest books a RoomType; the booking transaction assigns a free Room. A
// PostgreSQL exclusion constraint (see the first migration) makes overlapping
// active reservations for the same Room impossible, even under concurrent requests.
// Resorts that sell individual rooms simply have one Room per RoomType.
//
// Money: Decimal(10,2) rupees everywhere; Razorpay amounts are integer paise.
// Dates: check-in/out are calendar dates (@db.Date) in the resort's timezone (IST).

// Node.js client: next dev, tests, scripts, and Node hosting.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Cloudflare Workers client (loads its WASM query compiler the Workers way).
// Used only by the Cloudflare build: next.config.ts aliases "#prisma" to it.
generator workerd {
  provider = "prisma-client"
  output   = "../src/generated/prisma-workerd"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────────────────────── Enums

enum AdminRole {
  OWNER
  STAFF
}

enum BookingStatus {
  PENDING_PAYMENT // unit held while the guest pays the advance
  CONFIRMED // advance payment verified
  CANCELLED
  EXPIRED // hold ran out without a verified payment
}

enum BookingSource {
  WEBSITE
  ADMIN
}

enum ReservationKind {
  BOOKING
  BLOCK // admin-blocked dates (maintenance, private use, …)
}

enum ReservationStatus {
  HELD // temporary, until holdExpiresAt
  CONFIRMED
  BLOCKED
  RELEASED // no longer occupies the unit (cancelled / expired / unblocked)
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PlaceKind {
  NEARBY
  ATTRACTION
}

enum ActivityCategory {
  ADVENTURE
  RELAXATION
  FAMILY
  NATURE
}

enum InquiryStatus {
  NEW
  REPLIED
  ARCHIVED
}

// ───────────────────────────────────────────────────────────── Admin & settings

/// Dashboard users. Authentication is handled by Supabase Auth; this table
/// decides who is allowed in (a valid Supabase login alone is not enough).
model Admin {
  id         String    @id @default(uuid()) @db.Uuid
  authUserId String    @unique @db.Uuid /// auth.users.id in Supabase
  email      String    @unique
  name       String
  role       AdminRole @default(STAFF)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("admins")
}

/// Single-row table (id = 1) holding business details and booking rules.
model SiteSetting {
  id                 Int      @id @default(1)
  resortName         String
  shortName          String
  tagline            String
  description        String
  locationName       String
  address            String
  phone              String
  whatsapp           String
  email              String
  mapsUrl            String?
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  /// Percentage of the total collected online as an advance (1–100).
  advancePercent     Int      @default(30)
  /// Minutes a unit is held while the guest completes payment.
  holdMinutes        Int      @default(15)
  /// GST or other tax on room tariff. 0 = not shown.
  taxPercent         Decimal  @default(0) @db.Decimal(5, 2)
  /// true: listed prices already include tax. false: tax is added on top.
  pricesIncludeTax   Boolean  @default(true)
  minNights          Int      @default(1)
  maxNights          Int      @default(14)
  /// How far ahead guests may book.
  bookingWindowDays  Int      @default(365)
  checkInTime        String   @default("13:00")
  checkOutTime       String   @default("11:00")
  bookingPolicy      String
  cancellationPolicy String
  isPlaceholder      Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

// ───────────────────────────────────────────────────────────── Rooms & inventory

model RoomType {
  id               String            @id @default(uuid()) @db.Uuid
  slug             String            @unique
  name             String
  summary          String
  /// Paragraphs of the description.
  description      String[]
  basePrice        Decimal           @db.Decimal(10, 2)
  maxAdults        Int
  maxChildren      Int
  maxOccupancy     Int
  bedConfiguration String
  sizeSqFt         Int?
  /// Ordered list of { src, alt, isPlaceholder, credit? } — first is the main photo.
  images           Json              @default("[]")
  sortOrder        Int               @default(0)
  isActive         Boolean           @default(true)
  isPlaceholder    Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rooms            Room[]
  amenities        RoomTypeAmenity[]
  pricingRules     PricingRule[]
  bookings         Booking[]

  @@index([isActive, sortOrder])
  @@map("room_types")
}

/// A physical, bookable unit.
model Room {
  id           String        @id @default(uuid()) @db.Uuid
  roomTypeId   String        @db.Uuid
  name         String
  isActive     Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([roomTypeId, name])
  @@index([roomTypeId, isActive])
  @@map("rooms")
}

model Amenity {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique
  /// Name from the curated icon registry (src/components/ui/Icon.tsx).
  icon      String
  createdAt DateTime          @default(now())
  roomTypes RoomTypeAmenity[]

  @@map("amenities")
}

model RoomTypeAmenity {
  roomTypeId String   @db.Uuid
  amenityId  String   @db.Uuid
  sortOrder  Int      @default(0)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
  @@index([amenityId])
  @@map("room_type_amenities")
}

/// Overrides the base nightly price for a date range (e.g. peak season, weekends).
/// When several rules match a night, the highest priority wins.
model PricingRule {
  id            String   @id @default(uuid()) @db.Uuid
  roomTypeId    String   @db.Uuid
  name          String
  startDate     DateTime @db.Date /// inclusive
  endDate       DateTime @db.Date /// inclusive
  /// 0 = Sunday … 6 = Saturday. Empty = every day.
  daysOfWeek    Int[]
  pricePerNight Decimal  @db.Decimal(10, 2)
  priority      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  roomType      RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, isActive, startDate, endDate])
  @@map("pricing_rules")
}

// ───────────────────────────────────────────────────────────── Bookings & payments

model Booking {
  id                      String        @id @default(uuid()) @db.Uuid
  /// Human-friendly reference shown to guests, e.g. "GR-7KX2QH".
  code                    String        @unique
  /// SHA-256 of the secret token in the guest's booking link.
  accessTokenHash         String        @unique
  status                  BookingStatus @default(PENDING_PAYMENT)
  source                  BookingSource @default(WEBSITE)
  roomTypeId              String        @db.Uuid
  checkIn                 DateTime      @db.Date
  checkOut                DateTime      @db.Date
  nights                  Int
  adults                  Int
  children                Int
  guestName               String
  guestEmail              String
  guestPhone              String
  specialRequests         String?
  /// Snapshot of nightly prices at the time of booking: [{ date, price }].
  priceBreakdown          Json
  subtotal                Decimal       @db.Decimal(10, 2)
  taxPercent              Decimal       @db.Decimal(5, 2)
  taxAmount               Decimal       @db.Decimal(10, 2)
  totalAmount             Decimal       @db.Decimal(10, 2)
  advancePercent          Int
  advanceAmount           Decimal       @db.Decimal(10, 2)
  balanceAmount           Decimal       @db.Decimal(10, 2)
  currency                String        @default("INR")
  holdExpiresAt           DateTime?
  confirmedAt             DateTime?
  /// Set once the guest confirmation email has been accepted by the email provider.
  confirmationEmailSentAt DateTime?
  cancelledAt             DateTime?
  cancellationReason      String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  roomType                RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations            Reservation[]
  payments                Payment[]

  @@index([status, checkIn])
  @@index([checkIn])
  @@index([checkOut])
  @@index([guestEmail])
  @@index([createdAt])
  @@index([status, confirmationEmailSentAt])
  @@map("bookings")
}

/// Occupancy of one physical Room for [checkIn, checkOut). Overlaps between
/// active rows (HELD, CONFIRMED, BLOCKED) are rejected by the database.
model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  roomId        String            @db.Uuid
  bookingId     String?           @db.Uuid
  kind          ReservationKind
  status        ReservationStatus
  checkIn       DateTime          @db.Date
  checkOut      DateTime          @db.Date
  holdExpiresAt DateTime?
  /// Reason for an admin block.
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  room          Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  booking       Booking?          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([roomId, checkIn, checkOut])
  @@index([status, holdExpiresAt])
  @@index([bookingId])
  @@map("reservations")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @db.Uuid
  provider          String        @default("razorpay")
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  /// Smallest currency unit (paise).
  amountPaise       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String?
  errorCode         String?
  errorDescription  String?
  refundedPaise     Int           @default(0)
  capturedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds           Refund[]

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

/// One row per refund issued through Razorpay (audit trail; matched by refund.* webhooks).
model Refund {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @db.Uuid
  razorpayRefundId String   @unique
  amountPaise      Int
  /// Razorpay refund status: pending | processed | failed
  status           String
  reason           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}

/// Every Razorpay webhook event id we have processed — makes webhooks idempotent.
model WebhookEvent {
  id          String    @id /// Razorpay event id (x-razorpay-event-id)
  event       String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@map("webhook_events")
}

// ───────────────────────────────────────────────────────────── Website content

model Facility {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  description   String
  icon          String
  /// { src, alt, isPlaceholder, credit? } or null
  image         Json?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  isPlaceholder Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("facilities")
}

model Activity {
  id            String           @id @default(uuid()) @db.Uuid
  slug          String           @unique
  title         String
  summary       String
  description   String
  duration      String
  /// null with priceIncluded=false means "price on request".
  priceFrom     Decimal?         @db.Decimal(10, 2)
  priceIncluded Boolean          @default(false)
  priceNote     String?
  category      ActivityCategory
  images        Json             @default("[]")
  sortOrder     Int              @default(0)
  isActive      Boolean          @default(true)
  isPlaceholder Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([isActive, sortOrder])
  @@map("activities")
}

/// Nearby places and tourist attractions.
model Place {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique
  kind          PlaceKind
  name          String
  description   String
  distance      String
  travelTime    String
  location      String
  image         Json
  directionsUrl String?
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  isPlaceholder Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([kind, isActive, sortOrder])
  @@map("places")
}

model GalleryImage {
  id            String   @id @default(uuid()) @db.Uuid
  src           String
  alt           String
  caption       String?
  credit        Json?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  isPlaceholder Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("gallery_images")
}

model Testimonial {
  id            String   @id @default(uuid()) @db.Uuid
  quote         String
  author        String
  context       String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  isPlaceholder Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("testimonials")
}

model ContactInquiry {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_inquiries")
}
